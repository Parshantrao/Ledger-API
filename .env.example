# Copy to .env and adjust as needed.
NODE_ENV=development
PORT=3000

# Must point at a replica set (multi-document transactions are not supported on standalone mongod).
# Matches the Docker Compose setup in docker-compose.yml.
MONGODB_URI=mongodb://localhost:27017/account_ledger?replicaSet=rs0

# Optional: run the test suite against an existing replica set instead of the in-memory one.
# The database name must contain "test" because the suite deletes all documents between tests.
# MONGODB_TEST_URI=mongodb://localhost:27017/account_ledger_test?replicaSet=rs0
